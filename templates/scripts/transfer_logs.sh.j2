#!/bin/bash

# Transfer local log files to backup servers
# and delete old files on backup servers.
# It is triggered by systemd.timer.
#
## This script accepts one or two arguments:
#   1. Directory, file, or wildcard to transfer (e.g. /var/log/dmesg/*.gz)
#      - If a directory is specified, all files in the directory are processed
#      - If a file or wildcard is specified, only those files are processed
#   2. (Optional) Backup destination directory. If omitted, defaults to '{{ file_backup_log_transfer_dest_dir }}/$(hostname)'

set -euo pipefail


# Accept 1 or 2 arguments
if [ $# -lt 1 ] || [ $# -gt 2 ]; then
    echo "Usage: $0 <local_backup_directory_or_file> [backup_dir]"
    exit 1
fi

LOCAL_PATH="$1"
if [ -d "$LOCAL_PATH" ]; then
    LOCAL_FILES=("$LOCAL_PATH"/*)
else
    LOCAL_FILES=("$LOCAL_PATH")
fi

BACKUP_EXPIRE_DAYS={{ file_backup_expire_days }}
BACKUP_SERVERS="{{ file_backup_log_transfer_hosts }}"
REMOTE_USER="{{ file_backup_log_transfer_ssh_user }}"

# --------------------------------------------------------------------
# Helper Functions
# --------------------------------------------------------------------

function get_home_dir() {
    case "$1" in
        'root')
            echo "/root"
            ;;
        *)
            echo "/home/$1"
            ;;
    esac
}

# $1: directory path on backup servers
function make_dst_dir() {
    local DST_PATH="$1"
    for DST_SERVER in $BACKUP_SERVERS; do
        ssh -o StrictHostKeyChecking=no \
            -i $(get_home_dir {{ file_backup_user }})/{{ file_backup_ssh_key_file.lstrip('/') }} \
            ${REMOTE_USER}@${DST_SERVER} \
            "mkdir -p $DST_PATH"
    done
}

# Delete expired files on backup servers
# $1: directory, $2: regexp pattern
function delete_old_files() {
    local DST_PATH="$1"
    local REGEXP="$2"
    for DST_SERVER in $BACKUP_SERVERS; do
        ssh -o StrictHostKeyChecking=no \
            -i $(get_home_dir {{ file_backup_user }})/{{ file_backup_ssh_key_file.lstrip('/') }} \
            ${REMOTE_USER}@${DST_SERVER} \
            "find $DST_PATH -name \"$REGEXP\" -ctime +$BACKUP_EXPIRE_DAYS -delete" \
            && echo "Deleted old files on ${DST_SERVER}:${DST_PATH}"
    done
}

# --------------------------------------------------------------------
# Main Logic
# --------------------------------------------------------------------

function store_logs() {
    # 1. Scan .gz files in LOCAL_DIR_OR_FILE
    # 2. Check if file name contains date (YYYYMMDD)
    # 3. Create backup destination directory
    # 4. Transfer file to backup server
    # 5. Delete old files on backup server and local server
    for LOCAL_FILE in ${LOCAL_FILES}; do

        [ -e "$LOCAL_FILE" ] || continue   # NO FILE

        BASENAME=$(basename "$LOCAL_FILE")
        # 2. Skip files that do not end with .YYYYMMDD.gz
        if ! [[ "$BASENAME" =~ \.[0-9]{8}\.gz$ ]]; then
            continue
        fi

        # 3. Determine destination directory
        #
        # If backup and transfer servers are the same, the destination includes the hostname (e.g. /backup/$(hostname)/).
        # For S3 transfer (different servers), the hostname is extracted from LOCAL_PATH.
        #
        # --- Decide DEST_DIR ---
        # 1. If the second argument is specified, always use it (highest priority)
        # 2. If IS_S3_TRANSFER is true, extract hostname from LOCAL_PATH
        # 3. Otherwise, use default ({{ file_backup_log_transfer_dest_dir }}/$(hostname))
        if [ -n "${2:-}" ]; then
            DEST_DIR="$2"
        else
            IS_S3_TRANSFER="${IS_S3_TRANSFER:-false}"
            if [ "$IS_S3_TRANSFER" = "true" ] || [ "$IS_S3_TRANSFER" = "TRUE" ] || [ "$IS_S3_TRANSFER" = "1" ]; then
                # LOCAL_PATH should be like /backup/${hostname}/xxx.log.*.gz or /backup/${hostname}/*
                # Extract ${hostname} part (the directory name just after /backup/)
                HOSTNAME_FROM_PATH=$(basename "$(dirname "$LOCAL_FILE")")
                DEST_DIR="{{ file_backup_log_transfer_dest_dir }}/${HOSTNAME_FROM_PATH}"
            else
                # Default case: backup server and transfer server are the same, so use hostname in DEST_DIR
                DEST_DIR="{{ file_backup_log_transfer_dest_dir }}/$(hostname)"
            fi
        fi
        # Create destination directory
        make_dst_dir "$DEST_DIR"

        # 4. Transfer files with rsync
        # --ignore-existing: skip if same file exists on backup server
        for DST_SERVER in $BACKUP_SERVERS; do
            rsync -av \
                --ignore-existing \
                -e "ssh -o StrictHostKeyChecking=no -i $(get_home_dir {{ file_backup_user }})/{{ file_backup_ssh_key_file.lstrip('/') }}" \
                "$LOCAL_FILE" \
                ${REMOTE_USER}@${DST_SERVER}:${DEST_DIR}/ \
                && echo "Transferred $LOCAL_FILE to ${DST_SERVER}:${DEST_DIR}/"
        done

        # 5. Delete old logs on backup server
        ORIGINAL_FILE_PREFIX=$(echo "$BASENAME" | cut -d '.' -f 1)
        delete_old_files "${DEST_DIR}" "${ORIGINAL_FILE_PREFIX}.*"
        # 5. Delete old logs on local server
        find "$(dirname "$LOCAL_FILE")" -name "${ORIGINAL_FILE_PREFIX}.*" -ctime +$BACKUP_EXPIRE_DAYS -delete
    done
}

store_logs
exit 0
